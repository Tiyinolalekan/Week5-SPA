# Reviews service configuration. Vite reads these public values at startup/build.
# The default is an empty in-memory fake.
VITE_REVIEWS_SERVICE=fake
VITE_USE_SEED_DATA=true

# For seeded fake data, keep the service as fake and set seed data to true.
# For a deployed API, set the service to http, keep seed data false, and
# uncomment a Functions base URL ending at /api (the app appends /reviews).
#VITE_REVIEWS_SERVICE=http
#VITE_REVIEWS_BASE_URL=https://reviews-test-to05-func.azurewebsites.net/api
